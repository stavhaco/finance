# Copy to scripts/ci/remote-ollama.env and fill in after running on your Mac:
#   ./scripts/mac/enable_ollama_lan.sh
#   ./scripts/mac/show_ollama_bridge_url.sh
#
# Use a URL that responds with ✓ from the Mac script (LAN or Tailscale).
# Do NOT commit remote-ollama.env (contains your home IP).

OLLAMA_BASE_URL=http://192.168.1.XXX:11434
OLLAMA_MODEL=llama3.2

# Optional: same as production trader tuning
# DEMO_TRADER_MAYA_ENABLED=0
# DEMO_TRADER_ENFORCE_TASE_HOURS=0
