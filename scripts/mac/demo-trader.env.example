# Copy to scripts/mac/demo-trader.env and customize.
# Used by scripts/mac/run_cycle.sh and install_launchd.sh

# Absolute path to this git repo (recommended — avoids auto-detect warnings).
REPO_ROOT=/Users/stavhacohen/projects/finance

# Python: leave empty to require REPO_ROOT/.venv/bin/python (see run_cycle.sh)
# PYTHON_BIN=

# Ollama — must be running for live cycles (not --dry-run)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
DEMO_TRADER_OLLAMA_ENRICHMENT_MODEL=

# Paths (relative to REPO_ROOT unless absolute)
DEMO_TRADER_DB_PATH=data/trader.db
DEMO_TRADER_STATE_PATH=data/paper_state.json

# Knowledge: queue rows for async enrichment (fast cycles) + worker
DEMO_TRADER_KNOWLEDGE_ENRICH_ON_INGEST=1
DEMO_TRADER_KNOWLEDGE_ENRICH_ASYNC=1
DEMO_TRADER_KNOWLEDGE_ENRICH_FETCH_BODY=1
# Run in another terminal or launchd: ./scripts/mac/run_enrich_worker.sh --limit 8

# Maya API (set 0 to skip when maya.tase.co.il is unreachable from your network)
DEMO_TRADER_MAYA_ENABLED=1
DEMO_TRADER_MAYA_HTTP_CONNECT_TIMEOUT_SEC=10
DEMO_TRADER_MAYA_HTTP_READ_TIMEOUT_SEC=25

# Simulation (0 = live paper trading against current prices)
DEMO_TRADER_SIMULATION=0
DEMO_TRADER_ENFORCE_TASE_HOURS=1

# Deploy capital (prompt): prefer buys when cash > ~15% of NAV
DEMO_TRADER_MAX_CASH_PCT_TARGET=15
DEMO_TRADER_MIN_BUYS_WHEN_TRADING=1
DEMO_TRADER_MAX_TRADES_PER_CYCLE=5

# Per-cycle audit JSON (inputs + model output + executions)
DEMO_TRADER_CYCLE_LOG_ENABLED=1
DEMO_TRADER_CYCLE_LOG_DIR=data/logs/cycles
DEMO_TRADER_CYCLE_LOG_FULL_PROMPTS=0

# Slimmer Ollama trade prompt (focus symbols + prompt version tag on cycles)
DEMO_TRADER_PROMPT_SLIM_RECOMMENDATIONS=1
DEMO_TRADER_PROMPT_FOCUS_MAX_SYMBOLS=18
DEMO_TRADER_PROMPT_VERSION=v2-slim

# Optional: skip trade LLM when no high-usefulness news and flat book
# DEMO_TRADER_SKIP_CYCLE_WITHOUT_HIGH_NEWS=0

# Optional: smaller/faster model for enrichment only
# DEMO_TRADER_OLLAMA_ENRICHMENT_MODEL=llama3.2
